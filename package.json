{
  "name": "fantasy-eleven",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --conditions=react-server --experimental-strip-types --test $(find src/domain src/lib src/data-access -name '*.test.ts')",
    "test:integration": "node --env-file=.env.local --conditions=react-server --experimental-strip-types --test src/lib/fantasy-engine/draft-engine.integration.test.ts src/lib/fantasy-engine/market-trades.integration.test.ts src/lib/fantasy-engine/season.integration.test.ts src/lib/fantasy-engine/multi-season-lifecycle.integration.test.ts src/lib/fantasy-engine/international-scoring.integration.test.ts src/data-access/players.integration.test.ts src/data-access/matchups.integration.test.ts src/data-access/roster.integration.test.ts src/data-access/drafts.integration.test.ts src/lib/football-ingestion/live-sync.integration.test.ts src/lib/fantasy-engine/reconciliation.integration.test.ts",
    "football:check": "node --env-file=.env.local --conditions=react-server --experimental-strip-types src/lib/football-providers/api-football/check-connectivity.ts",
    "football:sync": "node --env-file=.env.local --conditions=react-server --experimental-strip-types src/lib/football-ingestion/cli.ts",
    "scoring:backfill": "node --env-file=.env.local --conditions=react-server --experimental-strip-types src/lib/scoring/cli.ts",
    "scoring:replay": "node --env-file=.env.local --conditions=react-server --experimental-strip-types src/lib/scoring/cli.ts replay",
    "fantasy:simulate": "node --env-file=.env.local --conditions=react-server --experimental-strip-types src/lib/fantasy-engine/cli.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "supabase": "^2.118.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
