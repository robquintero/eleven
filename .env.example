# Copy to .env.local and fill in with values from your Supabase project
# settings (Project Settings -> API). Never commit .env.local — it's
# gitignored on purpose.

# Project URL and publishable key — safe to expose to the browser, used by
# src/lib/supabase/client.ts and src/lib/supabase/server.ts.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Service-role (admin) key — server-only, NEVER exposed to the browser,
# NEVER prefixed with NEXT_PUBLIC_. As of Pass 10.5C.2A, ordinary Team
# lineup editing (swapping/filling starters, changing formation) does NOT
# need this — it writes through the authenticated request-scoped client
# under a real RLS policy instead. This key is still required for the
# draft's own round-1-opening self-heal and the football-ingestion CLI,
# which use the privileged admin Supabase client
# (src/lib/supabase/admin.ts) for genuine multi-team/system operations.
# Leaving it as a placeholder silently skips the round-1-opening self-heal
# (surfacing as "No fantasy round is open yet." rather than a separate
# configuration error) and breaks ingestion. Get it from Project Settings
# -> API. Prefer naming it SUPABASE_SECRET_KEY (this project's newer
# Supabase API key naming); SUPABASE_SERVICE_ROLE_KEY (the legacy name,
# used below) is still read as a fallback for compatibility.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# API-Football (https://www.api-football.com) v3 key — server-only, NEVER
# exposed to the browser, NEVER prefixed with NEXT_PUBLIC_. Used only by
# src/lib/football-providers/api-football/client.ts. Get it from your
# API-Football dashboard's API Keys page. Run `npm run football:check`
# once this is set to verify connectivity without spending real quota on
# anything beyond one cheap /status request.
API_FOOTBALL_KEY=your-api-football-key
