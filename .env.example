# Copy to .env.local and fill in with values from your Supabase project
# settings (Project Settings -> API). Never commit .env.local — it's
# gitignored on purpose.

# Project URL and publishable key — safe to expose to the browser, used by
# src/lib/supabase/client.ts and src/lib/supabase/server.ts.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Service-role (admin) key — server-only, NEVER exposed to the browser,
# NEVER prefixed with NEXT_PUBLIC_. REQUIRED, not optional: Team lineup
# editing (swapping/filling starters, changing formation), draft round-1
# auto-open, and the football-ingestion CLI all use the privileged admin
# Supabase client (src/lib/supabase/admin.ts), which throws/no-ops without
# this. Leaving it as a placeholder produces "Lineup editing isn't
# configured" in the Team UI and silently skips the draft's own
# round-1-opening self-heal — this is the single most common cause of
# both. Get it from Project Settings -> API. Prefer naming it
# SUPABASE_SECRET_KEY (this project's newer Supabase API key naming);
# SUPABASE_SERVICE_ROLE_KEY (the legacy name, used below) is still read as
# a fallback for compatibility.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# API-Football (https://www.api-football.com) v3 key — server-only, NEVER
# exposed to the browser, NEVER prefixed with NEXT_PUBLIC_. Used only by
# src/lib/football-providers/api-football/client.ts. Get it from your
# API-Football dashboard's API Keys page. Run `npm run football:check`
# once this is set to verify connectivity without spending real quota on
# anything beyond one cheap /status request.
API_FOOTBALL_KEY=your-api-football-key
