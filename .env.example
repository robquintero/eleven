# Copy to .env.local and fill in with values from your Supabase project
# settings (Project Settings -> API). Never commit .env.local — it's
# gitignored on purpose.

# Project URL and publishable key — safe to expose to the browser, used by
# src/lib/supabase/client.ts and src/lib/supabase/server.ts.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Service-role key — server-only, NEVER exposed to the browser, NEVER
# prefixed with NEXT_PUBLIC_. Not currently used by any code in this pass
# (no trusted-ingestion server code exists yet), but reserved for when it
# does. Get it from the same Project Settings -> API page.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
